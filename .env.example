# ==============================================================================
# CloudShare Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file with production secrets!
# ==============================================================================

# Database Configuration (PostgreSQL / AWS RDS)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cloudshare
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudshare
DB_USERNAME=postgres

# Clerk Authentication
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here
CLERK_WEBHOOK_VERIFY=true

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# AWS S3 Configuration
# In production on EC2/ECS, AWS credentials are automatically resolved via IAM Role
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
AWS_REGION=ap-south-1

# Server & CORS
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Frontend Configuration
VITE_BACKEND_URL=https://your-backend-url/api/v1.0
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
VITE_RAZORPAY_KEY=rzp_test_your_key_id_here
