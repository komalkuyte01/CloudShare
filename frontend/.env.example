# CloudShare Frontend Environment Variables Template
# Copy this file to .env in the frontend directory and configure your values.

# Backend API Base URL (e.g., Cloudflare tunnel or AWS backend)
VITE_BACKEND_URL=https://your-backend-url/api/v1.0

# Clerk Authentication Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Razorpay Key ID
VITE_RAZORPAY_KEY=rzp_test_your_key_id_here
